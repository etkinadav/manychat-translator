# Google Cloud Translation (optional for /api/translate)
# Real GCP project ID (e.g. screen-translator-496203) — NOT the literal placeholder below
GOOGLE_CLOUD_PROJECT=

# Incoming chat defaults: Hebrew → English
TRANSLATE_TARGET_LANGUAGE=en
TRANSLATE_SOURCE_LANGUAGE=he

# Same MongoDB cluster/database as beams (users collection)
MONGO_URI=

# Same JWT secret as beams backend so tokens are compatible
JWT_KEY=

# Backend port (default 3000)
PORT=3000

# Comma-separated Vite dev origins allowed by CORS
FRONTEND_DEV_ORIGINS=http://localhost:5173
