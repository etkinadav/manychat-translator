{
  "manifest_version": 3,
  "name": "Manychat Translator (scaffold)",
  "version": "0.2.0",
  "description": "Detects Manychat chat messages, sends them to a local backend, and renders the response inline under each message.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://app.manychat.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.manychat.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
