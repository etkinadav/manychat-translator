{
  "manifest_version": 3,
  "name": "Manychat Translator",
  "version": "0.3.0",
  "description": "Translates Manychat messages using your account language and organization settings.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manychat Translator"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://app.manychat.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:3000/*",
      "http://127.0.0.1:5173/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://app.manychat.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
